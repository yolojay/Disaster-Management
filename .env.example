# Production environment variable template
# Copy this to your hosting provider's environment variable settings.
# Replace placeholder values with your real credentials.

IBM_API_KEY=your-ibm-api-key-here
IBM_PROJECT_ID=xxxxxxxx-xxxx-4xxx-xxxx-xxxxxxxxxxxx
IBM_WML_URL=https://eu-de.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-4-h-small

# Optional: add extra allowed CORS origins if needed
# ALLOWED_ORIGINS=https://your-custom-domain.com
